# Copy this file to .env and fill in your values. Never commit .env.
# Every value below is optional — php/config/config.php falls back to these
# same defaults, so a standard local MySQL setup needs no .env at all.

SAWA_APP_ENV=development
# XAMPP, project folder in htdocs:  http://127.0.0.1/sawa
# PHP built-in server (router.php):  http://127.0.0.1:8000
SAWA_APP_URL=http://127.0.0.1/sawa

SAWA_DB_HOST=127.0.0.1
SAWA_DB_PORT=3306
SAWA_DB_NAME=sawa
SAWA_DB_USER=root
SAWA_DB_PASS=

SAWA_MAIL_FROM=noreply@sawa.local

# Session cookie signing. Use 64+ random bytes in production.
SAWA_SESSION_SECRET=change_this_to_a_long_random_string_at_least_64_chars
